<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>المتجر - طلبات الجملة</title>
  <style>
    body { font-family: Tahoma, Arial, sans-serif; background: #f5f6fa; margin: 0; padding: 20px; color: #222; }
    header { display: flex; justify-content: space-between; align-items: center; background: #fff; padding: 14px 20px; border-radius: 10px; box-shadow: 0 2px 6px rgba(0,0,0,.06); margin-bottom: 20px; }
    a.btn { background: #1d6feb; color: #fff; text-decoration: none; padding: 8px 14px; border-radius: 8px; font-size: 14px; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px; }
    .card { background: #fff; border-radius: 10px; padding: 14px; box-shadow: 0 2px 6px rgba(0,0,0,.06); text-align: center; }
    .card img { width: 100%; height: 150px; object-fit: cover; border-radius: 8px; background: #eee; }
    .card h3 { margin: 10px 0 6px; font-size: 16px; }
    .card p { margin: 0; color: #666; font-size: 13px; }
  </style>
</head>
<body>
  <header>
    <h2>متجر الجملة</h2>
    <a class="btn" href="/admin.html">لوحة التحكم</a>
  </header>
  <div id="stores" class="grid">جاري تحميل المتاجر...</div>

  <script>
    fetch('/api/stores')
      .then(r => r.json())
      .then(stores => {
        const box = document.getElementById('stores');
        if (!Array.isArray(stores) || stores.length === 0) {
          box.innerHTML = '<p>لا توجد متاجر مضافة حالياً. يمكنك إضافتها من لوحة التحكم.</p>';
          return;
        }
        box.innerHTML = stores.map(s => `
          <div class="card">
            ${s.image ? <img src="${s.image}" alt="${s.name}" /> : ''}
            <h3>${s.name || ''}</h3>
            <p>${s.description || ''}</p>
          </div>
        `).join('');
      })
      .catch(() => {
        document.getElementById('stores').innerHTML = '<p>تعذر تحميل المتاجر حالياً.</p>';
      });
  </script>
</body>
</html>
