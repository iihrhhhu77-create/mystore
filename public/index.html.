<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>منصة الجملة 24/7</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 pb-24">

    <header class="bg-blue-700 text-white p-4 sticky top-0 z-40 shadow flex justify-between items-center">
        <div class="flex items-center gap-3">
            <button id="backBtn" onclick="goHome()" class="hidden bg-blue-800 px-3 py-1.5 rounded-lg text-xs font-bold">← المتاجر</button>
            <div>
                <h1 id="headerTitle" class="font-bold text-base">جملة ماركت 24/7</h1>
                <p id="headerSub" class="text-xs text-blue-200">تسوق بالجملة لأصحاب المحلات</p>
            </div>
        </div>
        <button onclick="toggleCart()" class="bg-white text-blue-700 px-3.5 py-2 rounded-full font-bold text-xs shadow flex items-center gap-1.5">
            <span>السلة</span>
            <span id="cartCount" class="bg-red-600 text-white rounded-full px-2 py-0.5">0</span>
        </button>
    </header>

    <main class="max-w-4xl mx-auto p-4 space-y-6">
        <section id="storesView">
            <h2 class="font-bold text-gray-800 mb-3">اختر المتجر:</h2>
            <div id="storesGrid" class="grid grid-cols-2 md:grid-cols-3 gap-4"></div>
        </section>

        <section id="storeView" class="hidden space-y-5">
            <input type="text" id="searchInput" onkeyup="loadProducts()" placeholder="ابحث عن منتج داخل المتجر..." class="w-full p-3.5 rounded-xl border bg-white shadow-sm outline-none focus:ring-2 focus:ring-blue-500">

            <div id="productsGrid" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>

            <div class="bg-white p-5 rounded-2xl border border-dashed border-blue-400 shadow-sm">
                <h3 class="font-bold text-gray-800 text-sm mb-1">لم تجد المنتج المطلوب؟</h3>
                <p class="text-xs text-gray-500 mb-3">اكتب اسم المنتج والكمية وأرفق صورة للتوضيح</p>
                <form id="customReqForm" class="space-y-3">
                    <input type="text" name="description" required placeholder="اسم المنتج والكمية..." class="w-full p-2.5 border rounded-lg text-sm">
                    <input type="file" name="image" accept="image/*" class="w-full p-2 border rounded-lg text-xs">
                    <button type="submit" class="w-full bg-gray-800 text-white py-2.5 rounded-lg text-sm font-bold">إرسال الطلب الخاص</button>
                </form>
            </div>
        </section>
    </main>

    <div id="cartModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50 flex items-end md:items-center justify-center">
        <div class="bg-white w-full max-w-lg rounded-t-2xl md:rounded-2xl p-5 max-h-[90vh] overflow-y-auto space-y-4">
            <div class="flex justify-between items-center border-b pb-2">
                <h2 class="font-bold text-base">سلة المشتريات</h2>
                <button onclick="toggleCart()" class="text-xl font-bold text-gray-500">&times;</button>
            </div>
            <div id="cartItems" class="space-y-2 text-sm"></div>
            <div class="border-t pt-2 flex justify-between font-bold">
                <span>المجموع:</span>
                <span id="cartTotal" class="text-blue-700">0</span>
            </div>
            <form id="orderForm" class="space-y-2.5 bg-gray-50 p-3 rounded-xl">
                <input type="text" id="custName" required placeholder="الاسم أو اسم المحل" class="w-full p-2.5 border rounded-lg text-sm bg-white">
                <input type="tel" id="custPhone" required placeholder="رقم الهاتف" class="w-full p-2.5 border rounded-lg text-sm bg-white">
                <input type="text" id="custLocation" required placeholder="الموقع / العنوان" class="w-full p-2.5 border rounded-lg text-sm bg-white">
                <button type="submit" class="w-full bg-green-600 text-white py-3 rounded-xl font-bold text-sm">إرسال الطلبية</button>
            </form>
        </div>
    </div>

    <script>
        var currentStoreId = null;
        var currentProducts = [];
        var cart = [];

        function loadStores() {
            fetch('/api/stores')
                .then(function (res) { return res.json(); })
                .then(function (stores) {
                    var grid = document.getElementById('storesGrid');
                    if (!stores.length) {
                        grid.innerHTML = '<p class="text-gray-500 col-span-2">لا توجد متاجر بعد. أضف متجراً من <a href="/admin.html" class="text-blue-600 underline">لوحة التحكم</a>.</p>';
                        return;
                    }
                    var html = '';
                    for (var i = 0; i < stores.length; i++) {
                        var s = stores[i];
                        var imgSrc = s.image ? s.image : 'https://placehold.co/300x200?text=Store';
                        var safeName = s.name.replace(/'/g, "\\'");
                        html += '<div onclick="openStore(' + s.id + ', \'' + safeName + '\')" class="bg-white rounded-2xl overflow-hidden shadow-sm border cursor-pointer hover:shadow-md transition">';
                        html += '<img src="' + imgSrc + '" class="w-full h-36 object-cover bg-gray-100">';
                        html += '<div class="p-3 text-center font-bold text-gray-800 text-sm">' + s.name + '</div>';
                        html += '</div>';
                    }
                    grid.innerHTML = html;
                });
        }

        function openStore(id, name) {
            currentStoreId = id;
            document.getElementById('storesView').classList.add('hidden');
            document.getElementById('storeView').classList.remove('hidden');
            document.getElementById('backBtn').classList.remove('hidden');
            document.getElementById('headerTitle').innerText = name;
            document.getElementById('headerSub').innerText = 'تصفح المنتجات وأضف للسلة';
            document.getElementById('searchInput').value = '';
            loadProducts();
        }

        function goHome() {
            currentStoreId = null;
            document.getElementById('storeView').classList.add('hidden');
            document.getElementById('storesView').classList.remove('hidden');
            document.getElementById('backBtn').classList.add('hidden');
            document.getElementById('headerTitle').innerText = 'جملة ماركت 24/7';
            document.getElementById('headerSub').innerText = 'تسوق بالجملة لأصحاب المحلات';
        }

        function loadProducts() {
            var q = encodeURIComponent(document.getElementById('searchInput').value || '');
            fetch('/api/products?storeId=' + currentStoreId + '&q=' + q)
                .then(function (res) { return res.json(); })
                .then(function (products) {
                    currentProducts = products;
                    var grid = document.getElementById('productsGrid');
                    if (!products.length) {
                        grid.innerHTML = '<p class="text-gray-400 col-span-2 text-center py-4">لا توجد منتجات مطابقة</p>';
                        return;
                    }
                    var html = '';
                    for (var i = 0; i < products.length; i++) {
                        var p = products[i];
                        var step = p.is_carton ? Math.max(1, parseInt(p.step, 10) || 1) : 1;
                        var imgSrc = p.image ? p.image : 'https://placehold.co/120x120?text=Product';
                        html += '<div class="bg-white p-4 rounded-2xl shadow-sm border flex flex-col justify-between gap-3">';
                        html += '<div class="flex gap-3">';
                        html += '<img src="' + imgSrc + '" class="w-20 h-20 rounded-xl object-cover bg-gray-100">';
                        html += '<div class="flex-1">';
                        html += '<h3 class="font-bold text-gray-800 text-sm">' + p.name + '</h3>';
                        html += '<p class="text-blue-600 font-bold text-sm mt-1">' + p.price + '</p>';
                        if (p.fixed_note) {
                            html += '<div class="mt-2 bg-amber-50 border border-amber-200 text-amber-900 text-xs p-2 rounded-lg select-none">' + p.fixed_note + '</div>';
                        }
                        html += '</div></div>';
                        html += '<div class="flex items-center justify-between gap-2 pt-2 border-t">';
                        html += '<div class="flex items-center border rounded-lg overflow-hidden bg-gray-50">';
                        html += '<button type="button" onclick="changeQty(' + p.id + ', -' + step + ', ' + step + ')" class="px-3 py-1.5 bg-gray-200 font-bold">-</button>';
                        html += '<input type="number" id="qty-' + p.id + '" value="' + step + '" onchange="validateQty(' + p.id + ', ' + step + ', ' + p.is_carton + ')" class="w-14 text-center font-bold text-sm bg-transparent outline-none">';
                        html += '<button type="button" onclick="changeQty(' + p.id + ', ' + step + ', ' + step + ')" class="px-3 py-1.5 bg-gray-200 font-bold">+</button>';
                        html += '</div>';
                        html += '<button type="button" onclick="addToCart(' + p.id + ')" class="flex-1 bg-blue-600 text-white py-2 px-3 rounded-lg text-xs font-bold">أضف للسلة</button>';
                        html += '</div></div>';
                    }
                    grid.innerHTML = html;
                });
        }

        function changeQty(id, delta, step) {
            var inp = document.getElementById('qty-' + id);
            var val = parseInt(inp.value, 10) || step;
            val += delta;
            if (val < step) val = step;
            inp.value = val;
        }

        function validateQty(id, step, isCarton) {
            var inp = document.getElementById('qty-' + id);
            var val = parseInt(inp.value, 10) || step;
            if (val < step) {
                val = step;
            } else if (isCarton) {
                val = Math.floor(val / step) * step;
                if (val < step) val = step;
            }
            inp.value = val;
        }

        function addToCart(id) {
            var prod = null;
            for (var i = 0; i < currentProducts.length; i++) {
                if (currentProducts[i].id === id) { prod = currentProducts[i]; break; }
            }
            if (!prod) return;
            var qty = parseInt(document.getElementById('qty-' + id).value, 10) || 1;
            var existing = null;
            for (var j = 0; j < cart.length; j++) {
                if (cart[j].id === id) { existing = cart[j]; break; }
            }
            if (existing) existing.qty += qty;
            else cart.push({ id: prod.id, name: prod.name, price: prod.price, qty: qty });
            updateCartUI();
            alert('تمت الإضافة إلى السلة');
        }

        function updateCartUI() {
            document.getElementById('cartCount').innerText = cart.length;
            var total = 0;
            var container = document.getElementById('cartItems');
            if (!cart.length) {
                container.innerHTML = '<p class="text-gray-400 text-center py-3">السلة فارغة</p>';
                document.getElementById('cartTotal').innerText = '0';
                return;
            }
            var html = '';
            for (var i = 0; i < cart.length; i++) {
                var item = cart[i];
                var sub = item.price * item.qty;
                total += sub;
                html += '<div class="flex justify-between items-center bg-gray-50 p-2.5 rounded-lg">';
                html += '<div><p class="font-bold">' + item.name + '</p><p class="text-xs text-gray-500">' + item.qty + ' × ' + item.price + '</p></div>';
                html += '<div class="flex items-center gap-2"><span class="font-bold text-blue-700">' + sub + '</span><button type="button" onclick="removeItem(' + i + ')" class="text-red-500 text-xs font-bold">حذف</button></div>';
                html += '</div>';
            }
            container.innerHTML = html;
            document.getElementById('cartTotal').innerText = total;
        }

        function removeItem(idx) {
            cart.splice(idx, 1);
            updateCartUI();
        }

        function toggleCart() {
            document.getElementById('cartModal').classList.toggle('hidden');
            updateCartUI();
        }

        document.getElementById('customReqForm').addEventListener('submit', function (e) {
            e.preventDefault();
            var fd = new FormData(e.target);
            if (currentStoreId) fd.append('store_id', currentStoreId);
            fetch('/api/custom-requests', { method: 'POST', body: fd })
                .then(function () {
                    e.target.reset();
                    alert('تم إرسال طلب المنتج الخاص بنجاح');
                });
        });

        document.getElementById('orderForm').addEventListener('submit', function (e) {
            e.preventDefault();
            if (!cart.length) return alert('السلة فارغة');
            var total = 0;
            for (var i = 0; i < cart.length; i++) {
                total += (cart[i].price * cart[i].qty);
            }
            fetch('/api/orders', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    customer_name: document.getElementById('custName').value,
                    phone: document.getElementById('custPhone').value,
                    location: document.getElementById('custLocation').value,
                    items: cart,
                    total: total
                })
            }).then(function () {
                cart = [];
                updateCartUI();
                toggleCart();
                e.target.reset();
                alert('تم إرسال طلبيتك بنجاح!');
            });
        });

        loadStores();
    </script>
</body>
</html>
