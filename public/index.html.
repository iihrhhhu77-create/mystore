<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>جملة ماركت 24/7</title>
  <style>
    * { box-sizing: border-box; font-family: Tahoma, Arial, sans-serif; }
    body { margin: 0; background: #f4f6f9; color: #1e293b; }
    header {
      background: #0f172a; color: #fff; padding: 14px 20px;
      display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;
    }
    .brand { font-size: 20px; font-weight: bold; }
    .top-actions { display: flex; gap: 10px; align-items: center; }
    .btn {
      border: none; border-radius: 8px; padding: 9px 14px; cursor: pointer;
      font-weight: bold; font-size: 14px; transition: 0.2s;
    }
    .btn-primary { background: #2563eb; color: #fff; }
    .btn-success { background: #16a34a; color: #fff; }
    .btn-warning { background: #f59e0b; color: #fff; }
    .btn-outline { background: #fff; color: #0f172a; border: 1px solid #cbd5e1; }
    .container { max-width: 1200px; margin: 20px auto; padding: 0 15px; }
    .stores-bar { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 10px; margin-bottom: 18px; }
    .store-card {
      background: #fff; border: 2px solid transparent; border-radius: 12px;
      padding: 10px 14px; min-width: 190px; cursor: pointer; display: flex; align-items: center; gap: 10px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.06);
    }
    .store-card.active { border-color: #2563eb; background: #eff6ff; }
    .store-card img { width: 46px; height: 46px; border-radius: 8px; object-fit: cover; background: #e2e8f0; }
    .search-row { display: flex; gap: 10px; margin-bottom: 18px; }
    .search-row input {
      flex: 1; padding: 10px 14px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 15px;
    }
    .products-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 16px;
    }
    .product-card {
      background: #fff; border-radius: 12px; padding: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06); display: flex; flex-direction: column; justify-content: space-between;
    }
    .product-card img {
      width: 100%; height: 155px; object-fit: cover; border-radius: 8px; background: #f1f5f9;
    }
    .prod-title { font-weight: bold; font-size: 15px; margin: 10px 0 4px; }
    .prod-meta { color: #475569; font-size: 13px; margin-bottom: 10px; }
    .qty-box { display: flex; align-items: center; justify-content: center; gap: 8px; margin-bottom: 10px; }
    .qty-box button {
      width: 32px; height: 32px; border-radius: 6px; border: 1px solid #cbd5e1;
      background: #f8fafc; font-weight: bold; cursor: pointer; font-size: 16px;
    }
    .qty-box span { min-width: 28px; text-align: center; font-weight: bold; }

    /* Modal السلة */
    .modal-backdrop {
      position: fixed; inset: 0; background: rgba(15,23,42,0.55);
      display: none; align-items: center; justify-content: center; z-index: 999; padding: 15px;
    }
    .modal-backdrop.open { display: flex; }
    .modal {
      background: #fff; width: 100%; max-width: 520px; border-radius: 14px;
      padding: 20px; max-height: 90vh; overflow-y: auto; box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }
    .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
    .close-btn { background: none; border: none; font-size: 22px; cursor: pointer; color: #64748b; }
    .cart-item {
      display: flex; align-items: center; justify-content: space-between; gap: 10px;
      border-bottom: 1px solid #e2e8f0; padding: 8px 0;
    }
    .cart-item img { width: 46px; height: 46px; border-radius: 6px; object-fit: cover; }
    .form-group { margin-bottom: 12px; }
    .form-group label { display: block; font-size: 13px; font-weight: bold; margin-bottom: 5px; }
    .form-group input, .form-group textarea {
      width: 100%; padding: 9px 12px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 14px;
    }
    .location-row { display: flex; gap: 8px; align-items: center; }
    .location-row input { flex: 1; }
    .btn-loc {
      background: #0284c7; color: #fff; border: none; border-radius: 8px;
      padding: 9px 12px; font-weight: bold; cursor: pointer; white-space: nowrap;
    }
    .custom-box {
      background: #fff; border-radius: 12px; padding: 18px; margin-top: 28px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }
  </style>
</head>
<body>
  <header>
    <div class="brand">جملة ماركت 24/7</div>
    <div class="top-actions">
      <button class="btn btn-warning" onclick="openCart()">
        السلة (<span id="cartCount">0</span>)
      </button>
    </div>
  </header>

  <div class="container">
    <div id="storesBar" class="stores-bar"></div>

    <div class="search-row">
      <input type="text" id="searchInput" placeholder="ابحث عن منتج..." oninput="loadProducts()" />
    </div>

    <div id="productsGrid" class="products-grid"></div>

    <div class="custom-box">
      <h3>لم تجد المنتج المطلوب؟</h3>
      <p style="color:#64748b;font-size:13px;">اكتب اسم المنتج والكمية وأرفق صورة توضيحية وسنعمل على توفيره لك.</p>
      <form id="customRequestForm" enctype="multipart/form-data">
        <div class="form-group">
          <label>الاسم أو اسم المحل</label>
          <input type="text" name="customer_name" placeholder="مثال: محل النجاح" required />
        </div>
        <div class="form-group">
          <label>رقم الهاتف</label>
          <input type="text" name="phone" placeholder="05XXXXXXXX" required />
        </div>
        <div class="form-group">
          <label>تفاصيل المنتج والكمية</label>
          <textarea name="notes" rows="2" placeholder="اكتب اسم المنتج والكمية المطلوبة..." required></textarea>
        </div>
        <div class="form-group">
          <label>صورة توضيحية (اختياري)</label>
          <input type="file" name="image" accept="image/*" />
        </div>
        <button type="submit" class="btn btn-primary">إرسال الطلب الخاص</button>
      </form>
    </div>
  </div>

  <!-- نافذة سلة المشتريات -->
  <div id="cartModal" class="modal-backdrop">
    <div class="modal">
      <div class="modal-header">
        <h3 style="margin:0;">سلة المشتريات</h3>
        <button class="close-btn" onclick="closeCart()">×</button>
      </div>

      <div id="cartItems"></div>
      <div style="margin:12px 0; font-weight:bold; font-size:16px;">
        المجموع: <span id="cartTotal">0</span> د.ج
      </div>

      <form id="orderForm">
        <div class="form-group">
          <label>الاسم أو اسم المحل</label>
          <input type="text" id="orderName" placeholder="الاسم أو اسم المحل" required />
        </div>
        <div class="form-group">
          <label>رقم الهاتف</label>
          <input type="text" id="orderPhone" placeholder="رقم الهاتف" required />
        </div>
        <div class="form-group">
          <label>الموقع / العنوان</label>
          <div class="location-row">
            <input type="text" id="orderLocation" placeholder="الموقع / العنوان" required />
            <button type="button" class="btn-loc" id="btnMyLocation" onclick="detectMyLocation()">موقعي</button>
          </div>
          <small id="locationStatus" style="color:#0284c7; display:block; margin-top:4px;"></small>
        </div>
        <button type="submit" class="btn btn-success" style="width:100%; padding:11px;">تأكيد الطلب</button>
      </form>
    </div>
  </div>

  <script>
    let selectedStoreId = null;
    let cart = JSON.parse(localStorage.getItem('wholesale_cart') || '[]');
    const cardQtys = {};

    function saveCart() {
      localStorage.setItem('wholesale_cart', JSON.stringify(cart));
      updateCartBadge();
    }

    function updateCartBadge() {
      const totalItems = cart.reduce((acc, item) => acc + (Number(item.qty) || 1), 0);
      document.getElementById('cartCount').textContent = totalItems;
    }

    async function loadStores() {
      const res = await fetch('/api/stores');
      const stores = await res.json();
      const bar = document.getElementById('storesBar');
      bar.innerHTML = '';

      const allCard = document.createElement('div');
      allCard.className = 'store-card' + (selectedStoreId === null ? ' active' : '');
      allCard.innerHTML = '<div><strong>كل المتاجر</strong><div style="font-size:12px;color:#64748b;">عرض الكل</div></div>';
      allCard.onclick = () => {
        selectedStoreId = null;
        loadStores();
        loadProducts();
      };
      bar.appendChild(allCard);

      stores.forEach((s) => {
        const div = document.createElement('div');
        div.className = 'store-card' + (selectedStoreId === s.id ? ' active' : '');
        div.innerHTML = `
          <img src="${s.image || 'https://via.placeholder.com/50?text=Store'}" alt="${s.name}" />
          <div>
            <strong>${s.name}</strong>
            <div style="font-size:12px;color:#64748b;">${s.description || ''}</div>
          </div>
        `;
        div.onclick = () => {
          selectedStoreId = s.id;
          loadStores();
          loadProducts();
        };
        bar.appendChild(div);
      });
    }

    async function loadProducts() {
      const q = encodeURIComponent(document.getElementById('searchInput').value.trim());
      let url = '/api/products?';
      if (selectedStoreId) url += 'store_id=' + selectedStoreId + '&';
      if (q) url += 'q=' + q;

      const res = await fetch(url);
      const products = await res.json();
      const grid = document.getElementById('productsGrid');
      grid.innerHTML = '';

      if (!products.length) {
        grid.innerHTML = '<p style="color:#64748b;">لا توجد منتجات حالياً.</p>';
        return;
      }

      products.forEach((p) => {
        if (!cardQtys[p.id]) cardQtys[p.id] = 1;
        const step = Number(p.carton_qty) > 1 ? Number(p.carton_qty) : 1;

        const card = document.createElement('div');
        card.className = 'product-card';
        card.innerHTML = `
          <div>
            <img src="${p.image || 'https://via.placeholder.com/220x150?text=Product'}" alt="${p.name}" />
            <div class="prod-title">${p.name}</div>
            <div class="prod-meta">
              السعر: <strong>${p.price}</strong> د.ج
              ${step > 1 ?  • كرتون: ${step} : ''}
            </div>
          </div>
          <div>
            <div class="qty-box">
              <button type="button" onclick="changeCardQty(${p.id}, ${step}, -1)">-</button>
              <span id="pqty-${p.id}">${cardQtys[p.id]}</span>
              <button type="button" onclick="changeCardQty(${p.id}, ${step}, 1)">+</button>
            </div>
            <button type="button" class="btn btn-primary" style="width:100%;" onclick='addToCart(${JSON.stringify(p)})'>
              إضافة إلى السلة
            </button>
          </div>
        `;
        grid.appendChild(card);
      });
    }

    function changeCardQty(id, step, dir) {
      const current = cardQtys[id] || step;
      const next = current + dir * step;
      cardQtys[id] = next >= step ? next : step;
      document.getElementById('pqty-' + id).textContent = cardQtys[id];
    }

    function addToCart(product) {
      const step = Number(product.carton_qty) > 1 ? Number(product.carton_qty) : 1;
      const qty = cardQtys[product.id] || step;
      const existing = cart.find((item) => item.id === product.id);
      if (existing) {
        existing.qty += qty;
      } else {
        cart.push({
          id: product.id,
          name: product.name,
          price: Number(product.price),
          carton_qty: step,
          image: product.image || '',
          qty: qty
        });
      }
      saveCart();
      alert('تمت إضافة المنتج إلى السلة');
    }

    function openCart() {
      renderCart();
      document.getElementById('cartModal').classList.add('open');
    }

    function closeCart() {
      document.getElementById('cartModal').classList.remove('open');
    }

    function renderCart() {
      const container = document.getElementById('cartItems');
      const totalEl = document.getElementById('cartTotal');
      if (!cart.length) {
        container.innerHTML = '<p style="text-align:center;color:#64748b;">السلة فارغة</p>';
        totalEl.textContent = '0';
        return;
      }

      let total = 0;
      container.innerHTML = cart.map((item, idx) => {
        const lineTotal = (Number(item.price) || 0) * (Number(item.qty) || 1);
        total += lineTotal;
        return `
          <div class="cart-item">
            <img src="${item.image || 'https://via.placeholder.com/46'}" alt="${item.name}" />
            <div style="flex:1;">
              <div><strong>${item.name}</strong></div>
              <div style="font-size:12px;color:#475569;">${item.qty} × ${item.price} د.ج = <strong>${lineTotal}</strong> د.ج</div>
            </div>
            <button type="button" class="btn btn-outline" onclick="removeCartItem(${idx})">حذف</button>
          </div>
        `;
      }).join('');
      totalEl.textContent = total;
    }

    function removeCartItem(idx) {
      cart.splice(idx, 1);
      saveCart();
      renderCart();
    }

    function detectMyLocation() {
      const statusEl = document.getElementById('locationStatus');
      const locInput = document.getElementById('orderLocation');
      const btn = document.getElementById('btnMyLocation');

      if (!navigator.geolocation) {
        statusEl.textContent = 'المتصفح لا يدعم تحديد الموقع تلقائياً.';
        return;
      }

      btn.disabled = true;
      btn.textContent = 'جاري التحديد...';
      statusEl.textContent = 'يرجى السماح بالوصول إلى الموقع...';

      navigator.geolocation.getCurrentPosition(
        async (pos) => {
          const lat = pos.coords.latitude.toFixed(6);
          const lng = pos.coords.longitude.toFixed(6);
          const mapLink = https://maps.google.com/?q=${lat},${lng};
          let addressText = GPS (${lat}, ${lng}) - ${mapLink};

          try {
            const r = await fetch(https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&accept-language=ar);
            const data = await r.json();
            if (data && data.display_name) {
              addressText = ${data.display_name} (${mapLink});
            }
          } catch (e) {}

          locInput.value = addressText;
          statusEl.textContent = 'تم تحديد موقعك بنجاح.';
          btn.disabled = false;
          btn.textContent = 'موقعي';
        },
        (err) => {
          statusEl.textContent = 'تعذر تحديد الموقع تلقائياً، يمكنك كتابته يدوياً.';
          btn.disabled = false;
          btn.textContent = 'موقعي';
        },
        { enableHighAccuracy: true, timeout: 10000 }
      );
    }

    document.getElementById('orderForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!cart.length) {
        alert('السلة فارغة');
        return;
      }

      const customer_name = document.getElementById('orderName').value.trim();
      const phone = document.getElementById('orderPhone').value.trim();
      const location = document.getElementById('orderLocation').value.trim();
      const total = cart.reduce((acc, item) => acc + (Number(item.price) || 0) * (Number(item.qty) || 1), 0);

      const res = await fetch('/api/orders', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          customer_name,
          phone,
          location,
          wilaya: location,
          items: cart,
          total
        })
      });

      const data = await res.json();
      if (!res.ok) {
        alert(data.error || 'حدث خطأ أثناء إرسال الطلب');
        return;
      }

      cart = [];
      saveCart();
      closeCart();
      alert('تم إرسال طلبيتك بنجاح!');
    });

    document.getElementById('customRequestForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const res = await fetch('/api/custom-requests', {
        method: 'POST',
        body: formData
      });
      const data = await res.json();
      if (!res.ok) {
        alert(data.error || 'حدث خطأ أثناء إرسال الطلب الخاص');
        return;
      }
      e.target.reset();
      alert('تم إرسال طلب المنتج الخاص بنجاح');
    });

    updateCartBadge();
    loadStores();
    loadProducts();
  </script>
</body>
</html>
